# Copy this file to .env and fill in real values. Never commit .env.

# Session signing secret for the login system — generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Database (to be wired up — Neon/Postgres via Vercel Storage integration)
DATABASE_URL=postgres://user:password@host/dbname

# Optional integrations (leave blank until actually used)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:4028
